# Banker Analytics - Environment Configuration
# Copy this file to .env and update the values

# Secret key for session encryption (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-random-secret-here-min-32-chars-change-this-in-production

# Session security settings
# Set to true in production when using HTTPS
SESSION_SECURE_COOKIE=false

# Session timeout in minutes (0 = session lifetime / no expiration)
SESSION_COOKIE_LIFETIME_MINUTES=0

# Database path (SQLite file location)
# Default: banker_analytics.db (in application root)
DATABASE_PATH=banker_analytics.db

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application settings
APP_TITLE=Banker Analytics
APP_VERSION=3.0

# Server settings (optional)
# HOST=127.0.0.1
# PORT=8000

# Development mode (set to false in production)
DEBUG=true
